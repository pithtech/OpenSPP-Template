{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pre-commit run:*)",
      "Bash(./odoo-project:*)",
      "Bash(python odoo-project:*)",
      "Bash(odoo-project:*)",
      "Bash(python scripts/lint/odoo_lint.py:*)",
      "Bash(python scripts/lint/check_odoo19.py:*)",
      "Bash(python scripts/security_audit.py:*)",
      "Bash(uv run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(docker compose:*)",
      "Bash(ls:*)",
      "Bash(ruff check:*)",
      "WebSearch"
    ],
    "deny": ["Edit(upstream/**)", "Write(upstream/**)", "Edit(vendor/**)", "Write(vendor/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "openspp-plugins": {
      "source": {
        "source": "github",
        "repo": "OpenSPP/claude-plugins"
      }
    }
  }
}
