def interactive_mode():
    """Show interactive menu when no command is given."""
    if not sys.stdin.isatty():
        # Not interactive, show help instead
        cmd_help(None)
        return None

    print(_color("1;34", "OpenSPP Training Template Developer CLI"))
    print("")
    print("Select a command:")
    print("")

    for i, (cmd, desc) in enumerate(MAIN_COMMANDS, 1):
        print(f"  {_color('33', str(i)):>6})  {cmd:<12} {desc}")

    print("")
    try:
        choice = input(_color("1", "Enter number or command: ")).strip()
    except (EOFError, KeyboardInterrupt):
        print("")
        return None

    if not choice:
        return None

    # Handle numeric choice
    if choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(MAIN_COMMANDS):
            return [MAIN_COMMANDS[idx][0]]
        else:
            error(f"Invalid choice: {choice}")
            return None

    # Handle command name directly
    return choice.split()


def expand_aliases(argv: list) -> list:
    """Expand command aliases in argv.

    Example: ['t', 'dswd_attendance'] -> ['test', 'dswd_attendance']
    """
    result = []
    for arg in argv:
        if arg in ALIASES:
            result.append(ALIASES[arg])
        else:
            result.append(arg)
    return result


def split_chained_commands(argv: list) -> list:
    """Split argv into multiple command invocations.

    Example: ['resetdb', '--demo=mis', 'start'] -> [['resetdb', '--demo=mis'], ['start']]
    """
    if not argv:
        return [[]]

    # Only the main command names (no aliases, they're already expanded)
    command_names = {cmd for cmd, _ in MAIN_COMMANDS}
    chunks = []
    current = []
    current_has_command = False

    for arg in argv:
        if arg in command_names:
            if current_has_command:
                # Found a new command after already having one, start new chunk
                chunks.append(current)
                current = [arg]
            else:
                # First command in this chunk
                current.append(arg)
            current_has_command = True
        else:
            current.append(arg)

    if current:
        chunks.append(current)

    return chunks if chunks else [[]]


def main():
    # Handle hidden commands before argparse
    # nosemgrep: semgrep.odoo-timing-attack-password -- comparing CLI subcommand, not a secret
    if len(sys.argv) > 1 and sys.argv[1] == "_get_build_hash":
        cmd_get_build_hash(None)
        sys.exit(0)

    parser = build_parser()

    # Enable shell auto-completion if argcomplete is installed
    if HAS_ARGCOMPLETE:
        argcomplete.autocomplete(parser)

    # If no arguments, show interactive menu
    argv = sys.argv[1:]
    if not argv:
        argv = interactive_mode()
        if not argv:
            sys.exit(0)

    # Expand aliases (t -> test, s -> start, etc.)
    argv = expand_aliases(argv)

    # Split into chained commands
    chunks = split_chained_commands(argv)

    for chunk in chunks:
        args = parser.parse_args(chunk)

        # Set global dry-run mode
        global DRY_RUN
        if getattr(args, "dry_run", False):
            DRY_RUN = True
            info("Dry-run mode enabled - commands will be printed but not executed")

        if not args.command or args.command == "help":
            cmd_help(args)
            sys.exit(0)

        cmd_func = COMMANDS.get(args.command)
        if not cmd_func:
            error(f"Unknown command: {args.command}")
            cmd_help(args)
            sys.exit(1)

        try:
            cmd_func(args)
        except KeyboardInterrupt:
            print("\nInterrupted")
            sys.exit(130)
        except subprocess.CalledProcessError as e:
            sys.exit(e.returncode)


if __name__ == "__main__":
    main()
