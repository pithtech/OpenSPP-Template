def load_config() -> dict:
    """Load config from ~/.odoo-project.toml, returning defaults if not found."""
    config = DEFAULT_CONFIG.copy()
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "rb") as f:
