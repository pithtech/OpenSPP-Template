def _test_docker(module: str, tags: str | None = None):
    """Run module tests via Docker compose (pure Python, no bash dependency)."""
    import random
    from datetime import datetime

    # Validate module exists
    module_dir = PROJECT_ROOT / module
    if not (module_dir / "__manifest__.py").exists():
        error(f"Module '{module}' not found (no __manifest__.py in {module_dir})")
        sys.exit(1)

    # Ensure Docker available
    result = run(["docker", "info"], capture=True, check=False)
    if result.returncode != 0:
        error("Docker is not running or not installed")
        info("Install Docker: https://docs.docker.com/get-docker/")
        sys.exit(1)

    result = run(["docker", "compose", "version"], capture=True, check=False)
    if result.returncode != 0:
        error("Docker Compose plugin not found")
        info("Install: https://docs.docker.com/compose/install/")
        sys.exit(1)

    # Setup paths and names
    log_dir = Path(tempfile.gettempdir()) / "odoo-test-logs"
    log_dir.mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    log_file = log_dir / f"{module}_unittest_{timestamp}.log"
    db_name = f"test_{module}_{random.randint(1000000, 9999999)}"
    if not _validate_db_name(db_name):
        error(f"Module name produces invalid database name: {db_name}")
        sys.exit(1)
    test_tags = tags if tags else f"/{module}"

    print(f"Testing module: {module} (Docker mode)")
    print(f"Log file: {log_file}")

    # Start DB container
    print("Starting PostgreSQL container...")
    run(docker_compose("up", "-d", "db"), check=False)

    # Wait for DB to be ready
    print("Waiting for PostgreSQL to be ready...")
    db_ready = False
    for _ in range(30):
        result = run(
            docker_compose("exec", "-T", "db", "pg_isready", "-U", "odoo", "-d", "postgres"),
            capture=True,
            check=False,
        )
        if result.returncode == 0:
            db_ready = True
            break
        time.sleep(1)

    if not db_ready:
        error("PostgreSQL failed to start within 30 seconds")
        run(docker_compose("logs", "db"), check=False)
        sys.exit(1)

    # Check Docker image freshness (builds odoo-dev if needed)
    _check_image_freshness("dev", auto_rebuild=True)

    # Create temporary test database
    print("Creating test database...")
    result = run(
        docker_compose(
            "exec",
            "-T",
            "db",
            "psql",
            "-U",
            "odoo",
            "-d",
            "postgres",
            "-c",
            f"CREATE DATABASE {db_name};",
        ),
        capture=True,
        check=False,
    )
    if result.returncode != 0:
        error("Failed to create test database")
        sys.exit(1)

    # Run tests
    try:
        print("Running tests (this may take a few minutes)...")
        test_result = run(
            docker_compose(
                "run",
                "--rm",
                "-e",
                f"DB_NAME={db_name}",
                "--entrypoint",
                "",
                "test",
                "/opt/odoo/odoo/odoo-bin",
                f"--addons-path={_DOCKER_ADDONS_PATH}",
                "-d",
                db_name,
                "--db_host=db",
                "--db_port=5432",
                "--db_user=odoo",
                "--db_password=odoo",
                "--stop-after-init",
                "--no-http",
                "-i",
                module,
                "--test-tags",
                test_tags,
                "--log-level=test",
            ),
            capture=True,
            check=False,
        )

        # Save log
        log_content = (test_result.stdout or "") + (test_result.stderr or "")
        log_file.write_text(log_content)

    finally:
        # Always drop the temp database
        run(
            docker_compose(
                "exec",
                "-T",
                "db",
                "psql",
                "-U",
                "odoo",
                "-d",
                "postgres",
                "-c",
                f"DROP DATABASE IF EXISTS {db_name};",
            ),
            capture=True,
            check=False,
        )

    # Parse and display results
    _display_test_results(log_file)


def _display_test_results(log_file: Path):
    """Parse Odoo test log and display a summary."""
    log_content = log_file.read_text() if log_file.exists() else ""

    print("")
    print("========== TEST RESULTS ==========")

    # Find result summary line (e.g., "0 failed, 0 error(s) of 37 tests")
    result_match = re.search(r"(\d+) failed, (\d+) error\(s\) of (\d+) tests", log_content)

    if result_match:
        failed = int(result_match.group(1))
        errors = int(result_match.group(2))
        total = int(result_match.group(3))
        passed = total - failed - errors
        # Print the raw result line for consistency with bash output
        print(result_match.group(0))
    else:
        passed = failed = errors = 0

    print(f"Passed: {passed} | Failed: {failed} | Errors: {errors}")

    # Check for critical errors
    critical_error = None
    for line in log_content.split("\n"):
        if re.search(r"CRITICAL|Failed to load registry|MissingDependency|ImportError", line):
            critical_error = line.strip()
            break

    if critical_error:
        print(f"\nCRITICAL: {critical_error}")
        if "MissingDependency" in critical_error:
            print("\n--- Missing Dependency Details ---")
            for line in log_content.split("\n"):
                if "MissingDependency" in line or "External dependency" in line:
                    print(f"  {line.strip()}")

    if failed > 0 or errors > 0:
        print("\n--- Test failures ---")
        for line in log_content.split("\n"):
            if re.match(r"^(FAIL:|ERROR:|.*AssertionError)", line):
                print(f"  {line.strip()}")

    if passed == 0 and failed == 0 and errors == 0 and not critical_error:
        print("\nNOTE: No tests were executed. Check if:")
        print("      - Tests are tagged correctly" " (@tagged('post_install', '-at_install'))")
        print("      - Test files are in tests/ directory")
        print("      - Test classes inherit from TransactionCase/HttpCase")

    print(f"\nFull log: {log_file}")
    print("==================================")

    if failed > 0 or errors > 0:
        sys.exit(1)
    elif critical_error:
        sys.exit(2)


def _wait_for_odoo_ready(profile: str, timeout: int = 300):
    """Wait for Odoo to be ready (health check passes).

    Also monitors logs for CRITICAL errors that indicate initialization failure.
    Returns True if ready, False if timeout, raises SystemExit on fatal errors.
    """
    service = "odoo-dev" if profile == "dev" else "odoo-app"
    print("Waiting for Odoo to be ready...")

    for i in range(timeout):
        # Check for CRITICAL errors in logs (initialization failures)
        logs_result = run(
            docker_compose("logs", "--tail=50", service, profile=profile),
            check=False,
            capture=True,
        )
        if logs_result.returncode == 0:
            logs = logs_result.stdout + logs_result.stderr
            if "CRITICAL" in logs and "Failed to initialize database" in logs:
                error("Database initialization failed!")
                # Extract and show the error
                for line in logs.split("\n"):
                    if "CRITICAL" in line or "ParseError" in line or "ValueError" in line:
                        print(f"  {line.strip()}")
                print("\nCheck full logs with: ./odoo-project logs")
                sys.exit(1)

        # Check health endpoint
        result = run(
            docker_compose("exec", "-T", service, "curl", "-sf", "http://localhost:8069/web/health", profile=profile),
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            return True
        if i % 10 == 0 and i > 0:
            print(f"  Still waiting... ({i}s)")
        time.sleep(1)

    return False


def _is_fresh_database(profile: str) -> bool:
    """Check if this is a fresh database (no installed modules beyond base)."""
    service = "odoo-dev" if profile == "dev" else "odoo-app"
    code = "print(len(env['ir.module.module'].search([('state', '=', 'installed')])))"
    result = run(
        docker_compose(
            "exec",
            "-T",
            service,
            "odoo",
            "shell",
            "-d",
            "odoo",
            "--no-http",
            profile=profile,
        ),
        check=False,
        capture=True,
        input=code,
        text=True,
    )
    try:
        # Fresh DB typically has ~10-15 base modules
        count = int(result.stdout.strip().split("\n")[-1])
        return count < 20
    except (ValueError, IndexError):
        return False


def _get_module_state(profile: str, module_name: str) -> str:
    """Get the state of a module ('installed', 'to install', 'uninstalled', etc.)."""
    service = "odoo-dev" if profile == "dev" else "odoo-app"
    # Pass Python code via stdin (not -c which is for config file)
    code = (
        f"m = env['ir.module.module'].search([('name', '=', '{module_name}')], limit=1);"
        " print('STATE:' + (m.state if m else 'NOT_FOUND'))"
    )
    result = run(
        docker_compose(
            "exec",
            "-T",
            service,
            "odoo",
            "shell",
            "-d",
            "odoo",
            "--no-http",
            profile=profile,
        ),
        check=False,
        capture=True,
        input=code,
        text=True,
    )
    # Look for our STATE: marker in output
    for line in result.stdout.split("\n"):
        if line.startswith("STATE:"):
            return line[6:].strip()
    return "UNKNOWN"


def _wait_for_module_installed(profile: str, module_name: str, timeout: int = 600) -> tuple:
    """Wait for module installation by monitoring logs.

    Returns (success: bool, error_message: str or None)
    """
    service = "odoo-dev" if profile == "dev" else "odoo-app"
    print(f"Waiting for module '{module_name}' to be installed...")

    start_time = time.time()

    while time.time() - start_time < timeout:
        # Check recent logs for installation completion or errors
        result = run(
            docker_compose("logs", "--tail", "100", service, profile=profile),
            check=False,
            capture=True,
        )
        logs = result.stdout + result.stderr

        # Check for successful completion - "Registry loaded" appears after all modules installed
        # Note: Odoo logs "Modules loaded." (capital M) and "Registry loaded in X.XXXs"
        logs_lower = logs.lower()
        if "registry loaded in" in logs_lower and "modules loaded" in logs_lower:
            # Verify the module is actually installed now
            state = _get_module_state(profile, module_name)
            if state == "installed":
                return True, None
            elif state in ("to install", "to upgrade"):
                # Registry loaded but module not installed = installation failed
                return False, f"Module state is '{state}' after registry load - installation failed"

        # Check for fatal errors
        if "ParseError:" in logs or "ValueError:" in logs or "odoo.tools.convert.ParseError" in logs:
            # Extract error context
            for line in logs.split("\n"):
                if "ParseError:" in line or "ValueError:" in line:
                    return False, line.strip()

        elapsed = int(time.time() - start_time)
        if elapsed > 0 and elapsed % 30 == 0:
            print(f"  Still waiting... ({elapsed}s)")

        time.sleep(5)

    return False, "Timeout waiting for installation"


def _show_recent_logs(profile: str, lines: int = 50):
    """Show recent Odoo logs to help diagnose failures."""
    service = "odoo-dev" if profile == "dev" else "odoo-app"
    print("\n" + _color("1;31", f"=== Recent logs (last {lines} lines) ==="))
    run(
        docker_compose("logs", "--tail", str(lines), service, profile=profile),
        check=False,
    )
    print(_color("1;31", "=== End of logs ===") + "\n")


def cmd_start(args):
    """Start Odoo development server."""
    env = os.environ.copy()
    demo_modules = None

    # Set demo modules if specified
    if args.demo:
        demo_key = args.demo.lower().replace("-", "").replace("_", "")
        demo_modules = DEMO_PROFILES.get(demo_key, args.demo)
        print(f"Starting with demo: {demo_modules}")

    # Determine profile: dev (dynamic port) vs ui (fixed 8069)
    profile = args.profile

    # Check if Docker image needs rebuilding (unless --no-build)
    if not getattr(args, "no_build", False):
        _check_image_freshness(profile, auto_rebuild=args.yes)

    # Enable auto-reload for dev profile by default (disable with --no-watch)
    if profile == "dev" and not args.no_watch:
        env["ODOO_EXTRA_ARGS"] = "--dev=reload,qweb,xml"
        print("Auto-reload enabled (use --no-watch to disable)")

    # Wipe volumes if requested (removes DB data, filestore, everything)
    is_fresh_start = False
    if args.wipe:
        if not args.yes and not _confirm("This will DELETE all data (database, filestore). Continue?"):
            print("Cancelled.")
            sys.exit(0)
        print("Wiping all data (volumes)...")
        run(docker_compose("down", "-v", profile=profile), check=False)
        is_fresh_start = True
    elif not DRY_RUN and not _database_exists(os.environ.get("ODOO_DB_NAME", CONFIG.get("default_db", "odoo"))):
        # First start (or after `stop -v`): the entrypoint will create the database and
        # install the init modules, which takes several minutes. Wait for it.
        is_fresh_start = True

    if is_fresh_start and not demo_modules:
        demo_modules = DEFAULT_INIT_MODULES
        print(f"Fresh database: installing {demo_modules}")

    # Fresh start with demo modules: install them and wait until the registry is loaded,
    # so the first login does not race the installation.
    if is_fresh_start and demo_modules:
        print("\n" + _color("1;34", f"Installing {demo_modules} on a fresh database..."))
        env["ODOO_INIT_MODULES"] = demo_modules
        run(docker_compose("up", "-d", profile=profile), env=env)

        # Wait for Odoo to be ready first
        if not _wait_for_odoo_ready(profile, timeout=120):
            error("Odoo did not start")
            _show_recent_logs(profile, lines=50)
            sys.exit(1)

        # Wait for module installation to complete (monitors logs); for a list, watch the last one
        last_module = demo_modules.split(",")[-1].strip()
        installed, err_msg = _wait_for_module_installed(profile, last_module, timeout=900)
        if not installed:
            error(f"Module '{last_module}' failed to install!")
            if err_msg:
                error(f"Reason: {err_msg}")
            _show_recent_logs(profile, lines=100)
            sys.exit(1)

        success(f"Module '{demo_modules}' installed successfully")
    else:
        # Normal start (not a fresh wipe with demo)
        if demo_modules:
            env["ODOO_INIT_MODULES"] = demo_modules

        # Start services
        print(f"Starting Odoo ({profile} profile)...")
        run(docker_compose("up", "-d", profile=profile), env=env)

    # Show URL
    if profile == "dev":
        print("\nGetting dynamic port...")
        _show_url()
    else:
        print("\nOdoo available at: http://localhost:8069")
        print("Credentials: admin / admin")


