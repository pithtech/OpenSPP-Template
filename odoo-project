def _discover_modules(names: list | None = None) -> list:
    """Return module directories. If names given, validate they exist."""
    if names:
        modules = []
        for name in names:
            mod_dir = PROJECT_ROOT / name
            if not (mod_dir / "__manifest__.py").exists():
                error(f"Module '{name}' not found (no __manifest__.py)")
                sys.exit(1)
            modules.append(mod_dir)
        return modules

    # All modules in project root
    return sorted(p for p in PROJECT_ROOT.iterdir() if p.is_dir() and (p / "__manifest__.py").exists())


def cmd_fix_odoo19(args):
    """Fix Odoo 19 Command API compatibility issues."""
    modules = _discover_modules(args.modules or None)

    all_files = []
    for mod_dir in modules:
        for subdir in ("models", "wizard", "wizards"):
            target = mod_dir / subdir
            if target.is_dir():
                all_files.extend(str(f) for f in target.rglob("*.py") if "tests" not in f.parts)

    if not all_files:
        info("No Python files found in models/ or wizards/ directories")
        return

    print(f"Checking {len(all_files)} files across {len(modules)} module(s)...")

    cmd = [sys.executable, "scripts/lint/check_odoo19.py", "--fix"]
    if args.dry_run:
        cmd.append("--dry-run")
    cmd.extend(all_files)

    run(cmd, check=False)
    print("\nDone!")
    if args.dry_run:
        print("Run without --dry-run to apply the fixes.")


def cmd_audit_security(args):
    """Audit modules for access rights compliance."""
    cmd = [sys.executable, "scripts/security_audit.py"]

    if args.modules:
        cmd.extend(args.modules)
    else:
        cmd.append("--all")

    if args.report:
        cmd.append("--report")
    if args.json:
        cmd.append("--json")

    sys.exit(run(cmd, check=False).returncode)


