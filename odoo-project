def _get_build_inputs_hash() -> str:
    """Compute hash of files that affect Docker image build."""
    import hashlib

    files_to_hash = [
        PROJECT_ROOT / "docker" / "Dockerfile",
        PROJECT_ROOT / "docker" / "requirements.txt",
        PROJECT_ROOT / "requirements.txt",
        PROJECT_ROOT / "docker" / "odoo.conf.template",
        PROJECT_ROOT / "docker" / "entrypoint.sh",
    ]

    hasher = hashlib.md5(usedforsecurity=False)  # nosec B324
    for filepath in files_to_hash:
        if filepath.exists():
            hasher.update(filepath.read_bytes())

    return hasher.hexdigest()[:12]


def _marker_file(profile: str) -> Path:
    """Marker that records the build inputs the current image was made from."""
    return Path(tempfile.gettempdir()) / f".odoo-project-build-{profile}-{_get_build_inputs_hash()}"


def _mark_image_fresh():
    """Record that the local image matches the current build inputs (both profiles share it)."""
    for profile in ("dev", "ui"):
        _marker_file(profile).touch()


def _image_exists() -> bool:
    """Return True if the local Docker image is present."""
    result = run(["docker", "image", "inspect", ODOO_IMAGE], capture=True, check=False)
    return result.returncode == 0


def _pull_image() -> bool:
    """Pull the published image for the pinned release and tag it as the local image."""
    if not OPENSPP_REF:
        error("OPENSPP_REF is not set in .env")
        return False
    remote = f"{ODOO_IMAGE_REMOTE}:{OPENSPP_REF}"
    print(f"Pulling {remote} ...")
    sys.stdout.flush()
    result = run(["docker", "pull", remote], check=False)
    if result.returncode != 0:
        return False
    run(["docker", "tag", remote, ODOO_IMAGE])
    _mark_image_fresh()
    return True


def _build_image(service: str, profile: str):
    """Build the image locally (10-25 min) and record that it matches the current build inputs."""
    info("Building Docker image...")
    run(docker_compose("build", service, profile=profile))
    _mark_image_fresh()


def _pull_or_build(service: str, profile: str):
    """Pull the published image; build locally only when the pull fails."""
    if _pull_image():
        return
    warn("Pull failed (not logged in to GHCR, image not published, or no network). Building locally instead...")
    _build_image(service, profile)


def _check_image_freshness(profile: str = "dev", auto_rebuild: bool = False) -> bool:
    """Make sure a current Docker image exists. Returns True if fresh."""
    service = "odoo-dev" if profile == "dev" else "odoo-app"

    if not _image_exists():
        info(f"Docker image '{ODOO_IMAGE}' not found.")
        if auto_rebuild or _confirm("Pull the published image? (No = build locally, 10-25 min)", default=True):
            _pull_or_build(service, profile)
        else:
            _build_image(service, profile)
        return True

    # Check if build inputs changed
    if _marker_file(profile).exists():
        return True  # Image is fresh

    # Image might be stale: the published image is refreshed for the same inputs, so pull before building
    warn("Docker image may be outdated (Dockerfile or requirements changed)")

    if auto_rebuild:
        _pull_or_build(service, profile)
        return True

    if sys.stdin.isatty():
        if _confirm("Pull the published image? (No = keep the current one; `build` rebuilds it)", default=True):
            _pull_or_build(service, profile)
            return True
        warn("Continuing with potentially stale image")

    return False


def _confirm(prompt: str, default: bool = False) -> bool:
    """Ask for confirmation. Returns default if not a TTY."""
    if not sys.stdin.isatty():
        return default
    suffix = " [Y/n] " if default else " [y/N] "
    response = input(prompt + suffix).strip().lower()
    if not response:
        return default
    return response in ("y", "yes")


def _validate_db_name(name: str) -> bool:
    """Validate database name to prevent SQL injection."""
    # PostgreSQL identifiers: alphanumeric, underscore, must start with letter/underscore
    return bool(re.match(r"^[a-zA-Z_]\w*$", name)) and len(name) <= 63


def _database_exists(db_name: str) -> bool:
    """Return True if the database exists on the (started) db service."""
    if not _validate_db_name(db_name):
        error(f"Invalid database name '{db_name}'")
        sys.exit(1)
    run(docker_compose("up", "-d", "db"), check=False, capture=True)
    for _ in range(30):
        ready = run(
            docker_compose("exec", "-T", "db", "pg_isready", "-U", "odoo", "-d", "postgres"), capture=True, check=False
        )
        if ready.returncode == 0:
            break
        time.sleep(1)
    result = run(
        docker_compose(
            "exec",
            "-T",
            "db",
            "psql",
            "-U",
            "odoo",
            "-d",
            "postgres",
            "-tAc",
            f"SELECT 1 FROM pg_database WHERE datname = '{db_name}'",  # nosec B608 - validated identifier
        ),
        capture=True,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "1"


def _find_running_odoo() -> tuple:
    """Find running Odoo service and profile."""
    # Check both profiles
    for profile, service_name in [("ui", "odoo-app"), ("dev", "odoo-dev")]:
        result = run(
            docker_compose("ps", "--format", "json", profile=profile),
            capture=True,
            check=False,
        )
        if result.returncode != 0:
            continue

        # Parse JSON output (one object per line)
        for line in result.stdout.strip().split("\n"):
            if not line:
                continue
            try:
                container = json.loads(line)
                if container.get("Service") == service_name and container.get("State") == "running":
                    return service_name, profile
            except json.JSONDecodeError:
                continue

    return None, None


