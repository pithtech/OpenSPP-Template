def cmd_doctor(_args):
    """Check prerequisites and environment health."""
    print("Checking prerequisites...\n")
    all_ok = True

    # Check Docker
    docker_path = shutil.which("docker")
    if docker_path:
        result = run(["docker", "--version"], capture=True, check=False)
        if result.returncode == 0:
            success(f"Docker: {result.stdout.strip()}")
        else:
            error("Docker: installed but not working")
            all_ok = False
    else:
        error("Docker: not found")
        all_ok = False

    # Check Docker Compose
    result = run(["docker", "compose", "version"], capture=True, check=False)
    if result.returncode == 0:
        success(f"Docker Compose: {result.stdout.strip()}")
    else:
        error("Docker Compose: not found or not working")
        all_ok = False

    # Check Docker daemon, backend, and memory
    result = run(
        ["docker", "info", "--format", "{{.OSType}}|{{.KernelVersion}}|{{.MemTotal}}"], capture=True, check=False
    )
    if result.returncode == 0:
        success("Docker daemon: running")
        os_type, kernel, mem_total = (result.stdout.strip().split("|") + ["", "", ""])[:3]
        if sys.platform == "win32":
            if "WSL" in kernel or "microsoft" in kernel.lower():
                success("Docker backend: WSL 2")
            else:
                warn("Docker backend: not WSL 2 (enable 'Use the WSL 2 based engine' in Docker Desktop settings)")
        try:
            mem_gb = int(mem_total) / (1024**3)
            if mem_gb >= 6:
                success(f"Docker memory: {mem_gb:.1f} GB")
            elif mem_gb >= 4:
                warn(f"Docker memory: {mem_gb:.1f} GB (6 GB recommended for OpenSPP)")
            else:
                error(f"Docker memory: {mem_gb:.1f} GB (at least 4 GB required; raise it in Docker Desktop settings)")
                all_ok = False
        except ValueError:
            info("Docker memory: unknown")
    else:
        error("Docker daemon: not running (start Docker Desktop?)")
        all_ok = False

    # Check Python
    py = sys.version_info
    if py >= (3, 11):
        success(f"Python: {py.major}.{py.minor}.{py.micro}")
    else:
        error(f"Python: {py.major}.{py.minor} (3.11 or newer required)")
        all_ok = False

    # Check Node (pre-commit installs prettier/eslint with it)
    if shutil.which("node"):
        result = run(["node", "--version"], capture=True, check=False)
        success(f"Node.js: {result.stdout.strip()} (used by pre-commit formatters)")
    else:
        warn("Node.js: not found (needed by pre-commit prettier/eslint hooks)")

    # Check Git
    git_path = shutil.which("git")
    if git_path:
        result = run(["git", "--version"], capture=True, check=False)
        success(f"Git: {result.stdout.strip()}")
    else:
        warn("Git: not found (optional)")

    # Check pre-commit
    precommit_path = shutil.which("pre-commit")
    if precommit_path:
        result = run(["pre-commit", "--version"], capture=True, check=False)
        success(f"pre-commit: {result.stdout.strip()}")
    else:
        warn("pre-commit: not found (optional, for linting)")

    # Check argcomplete
    if HAS_ARGCOMPLETE:
        success("argcomplete: installed (tab completion available)")
    else:
        warn("argcomplete: not installed (optional, for tab completion)")
        info("  Install with: pip install argcomplete")

    # OpenSPP release, image, and source checkout
    print("")
    if OPENSPP_REF:
        success(f"OpenSPP release (from .env): {OPENSPP_REF}")
    else:
        error("OPENSPP_REF missing in .env")
        all_ok = False
    if _image_exists():
        success(f"Docker image: {ODOO_IMAGE} present")
    else:
        warn(f"Docker image: {ODOO_IMAGE} not found (run: ./odoo-project pull)")
    vendor_state, vendor_ref = _vendor_status()
    if vendor_state == "ok":
        success(f"OpenSPP source: vendor/openspp at {vendor_ref}")
    elif vendor_state == "stale":
        warn(f"OpenSPP source: vendor/openspp is at {vendor_ref}, expected {OPENSPP_REF} (run: ./odoo-project vendor)")
    else:
        warn("OpenSPP source: vendor/openspp missing (run: ./odoo-project vendor)")

    # Check config file
    print("")
    if CONFIG_PATH.exists():
        success(f"Config file: {CONFIG_PATH}")
    else:
        info(f"Config file: {CONFIG_PATH} (not found, using defaults)")
        info("  Create one with your preferences:")
        info("    echo 'default_demo = \"base\"' > ~/.odoo-project.toml")

    # Check port availability (8069)
    print("")
    import socket

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    port_available = sock.connect_ex(("localhost", 8069)) != 0
    sock.close()
    if port_available:
        success("Port 8069: available")
    else:
        warn("Port 8069: in use (Odoo may already be running)")

    # Summary
    print("")
    if all_ok:
        success("All prerequisites met!")
    else:
        error("Some prerequisites are missing. Please install them and try again.")


