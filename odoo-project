def _download_file(url: str, dest: Path):
    """Download url to dest (kept separate so tests can replace it)."""
    urllib.request.urlretrieve(url, dest)  # nosec B310 - fixed https URL built from the pinned tag


def _vendor_status() -> tuple:
    """Return ("ok" | "stale" | "missing", ref found in the checkout)."""
    ref_file = VENDOR_DIR / ".ref"
    if not ref_file.exists():
        return "missing", None
    ref = ref_file.read_text(encoding="utf-8").strip()
    return ("ok" if ref == OPENSPP_REF else "stale"), ref


def cmd_vendor(args):
    """Download the OpenSPP source at OPENSPP_REF into vendor/openspp (gitignored)."""
    if not OPENSPP_REF:
        error("OPENSPP_REF is not set in .env")
        sys.exit(1)

    status, ref = _vendor_status()
    if status == "ok" and not getattr(args, "force", False):
        success(f"vendor/openspp is already at {ref}")
        return
    if status == "stale":
        info(f"vendor/openspp is at {ref}, refreshing to {OPENSPP_REF}")

    url = OPENSPP_TARBALL_URL.format(ref=OPENSPP_REF)
    print(f"Downloading OpenSPP {OPENSPP_REF} ...")
    if DRY_RUN:
        info(f"[dry-run] download {url} -> {VENDOR_DIR}")
        return

    VENDOR_DIR.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=VENDOR_DIR.parent) as tmp:
        tmp_dir = Path(tmp)
        tarball = tmp_dir / "openspp.tar.gz"
        _download_file(url, tarball)

        extract_dir = tmp_dir / "extract"
        extract_dir.mkdir()
        with tarfile.open(tarball, "r:gz") as tar:
            # GitHub archives wrap everything in one top-level folder; strip it.
            tar.extractall(extract_dir, filter="data")
        top_levels = [p for p in extract_dir.iterdir() if p.is_dir()]
        if len(top_levels) != 1:
            error("Unexpected archive layout (expected a single top-level folder)")
            sys.exit(1)
        source_root = top_levels[0]
        (source_root / ".ref").write_text(OPENSPP_REF + "\n", encoding="utf-8")

        if VENDOR_DIR.exists():
            shutil.rmtree(VENDOR_DIR)
        shutil.move(str(source_root), str(VENDOR_DIR))

    success(f"OpenSPP {OPENSPP_REF} source is in {VENDOR_DIR.relative_to(PROJECT_ROOT)} (read-only reference)")


