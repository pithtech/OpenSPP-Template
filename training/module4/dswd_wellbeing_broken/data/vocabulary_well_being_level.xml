<?xml version="1.0" encoding="utf-8" ?>
<!--
    4Ps Well-Being Level vocabulary.

    The Social Welfare and Development Indicators (SWDI) assessment places each
    household at one of three levels. The numeric SWDI level is kept in the
    definition so the legacy PPIS value stays visible next to the readable code.
-->
<odoo noupdate="1">
    <record id="vocab_well_being_level" model="spp.vocabulary">
        <field name="name">4Ps Well-Being Level</field>
        <field name="namespace_uri">urn:dswd:4ps:well-being-level</field>
        <field name="description">Household well-being level from the SWDI assessment</field>
        <field name="is_system" eval="True" />
        <field name="domain">administrative</field>
    </record>

    <record id="code_well_being_survival" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_well_being_level" />
        <field name="code">survival</field>
        <field name="display">Survival</field>
        <field name="definition">SWDI level 1: the household cannot meet basic needs without assistance.</field>
        <field name="target_type">group</field>
        <field name="sequence">10</field>
    </record>

    <record id="code_well_being_subsistence" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_well_being_level" />
        <field name="code">subsistence</field>
        <field name="display">Subsistence</field>
        <field name="definition">SWDI level 2: the household meets basic needs but has no buffer.</field>
        <field name="target_type">group</field>
        <field name="sequence">20</field>
    </record>

    <record id="code_well_being_self_sufficient" model="spp.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_well_being_level" />
        <field name="code">self_sufficient</field>
        <field name="display">Self-Sufficient</field>
        <field name="definition">SWDI level 3: the household can sustain itself and may exit the program.</field>
        <field name="target_type">group</field>
        <field name="sequence">30</field>
    </record>
</odoo>
